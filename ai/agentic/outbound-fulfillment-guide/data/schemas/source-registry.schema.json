{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-registry.schema.json",
  "title": "Phase 0 空来源台账",
  "description": "Phase 0 只允许空来源台账。Phase 1 录入来源前必须升级本 Schema。",
  "type": "object",
  "required": ["$schema", "schema_version", "sources"],
  "properties": {
    "$schema": {
      "const": "../data/schemas/source-registry.schema.json"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "sources": {
      "type": "array",
      "maxItems": 0
    }
  },
  "additionalProperties": false
}
