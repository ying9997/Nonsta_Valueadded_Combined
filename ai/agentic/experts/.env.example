# LLM（与 scripts/llm-openai.ts 一致）
OPENAI_API_KEY=
# 可选：兼容 OpenAI 协议的网关
OPENAI_BASE_URL=
OPENAI_MODEL_EP=
OPENAI_MODEL=
MODEL_MAX_TOKENS=8192
MODEL_TEMPERATURE=0.7
MODEL_TOP_P=0.7
MODEL_FREQUENCY_PENALTY=0.0
MODEL_PRESENCE_PENALTY=0.0
# Coze Workflow：本地代理万邑通 OpenAPI 插件（fetch-outbound-order 等）
# 令牌勿提交仓库；泄露请尽快在 Coze 控制台轮换
COZE_API_TOKEN=
# 与 COZE_API_TOKEN 二选一即可
# COZE_WORKFLOW_PAT=
COZE_WINIT_WORKFLOW_ID=
COZE_WINIT_CUSTOMER_CODE=
COZE_WINIT_CUSTOMER_NAME=
COZE_WINIT_USERNAME=
# 可选
COZE_WINIT_LANGUAGE=
COZE_API_BASE_URL=https://api.coze.cn

# 万邑通 OpenAPI 代理工作流：`arithmetic-formula` 的 fetch 与出库一致；HTTP parameters 含 action + customerCode + customerName + username + data（其中 action 由 fetch 节点/环境变量决定，非调用 JSON 顶层字段）。本地也可用顶层 JSON 传 customerCode 等（不经 inputs），见 docs/design-spec.md §6
# 四则运算：经此工作流调 queryProductInventoryList4Page（id/58，取 qtyAvailable）
COZE_WINIT_OPENAPI_PROXY_WORKFLOW_ID=7623329033350168611
# 可选：覆盖 fetch 使用的 OpenAPI action（默认 queryProductInventoryList4Page）。须与 Coze 代理工作流内**已注册的路由**一致，否则会报 No handler found。
# COZE_WINIT_INVENTORY_ACTION=

# id/58（arithmetic-formula / fetch-sku-inventory）：须使用万邑通控制台里的真实「仓库编码」warehouseCode（文档示例如 US0001 未必适用你的账号）
# 本地 CLI：传 --warehouseCodes <编码>（无括号 SKU_QTY），或算式内 SKU_QTY(wh=<编码>, sku=...)
# 当前测试账号下商品名示例：basic 3pl test item 001、basic 3pl test item 002；示例仓库编码：USWC2

# queryOutboundOrderList 用日期范围（可选；不设则默认近一年）
# COZE_WINIT_LIST_DATE_START=2024-01-01
# COZE_WINIT_LIST_DATE_END=2025-03-20
# COZE_WINIT_LIST_PAGE_SIZE=50
# COZE_WINIT_LIST_PAGE_NUM=1
# 可选，见万邑通文档 id/54：status（如 ALL、VO）、warehouseId
# COZE_WINIT_LIST_STATUS=
# COZE_WINIT_LIST_WAREHOUSE_ID=
# TMS 运输单 queryPage：WI 关联 keywordType（默认 inboundOrderNo，联调确认后设置）
# COZE_WINIT_TMS_KEYWORD_TYPE=inboundOrderNo
# COZE_WINIT_TMS_QUERY_PAGE_ACTION=tms.transportorder.queryPage

# outbound-order-status resolve-outbound-lookup：模糊单号 id/54 每种查询最大翻页（默认 5）
# COZE_WINIT_RESOLVE_MAX_PAGES=5

# scripts/test-winit-openapi-call.ts：直连 cobra 签名与 client_id（勿提交真实值）
WINIT_OPENAPI_SIGN_TOKEN=
WINIT_OPENAPI_CLIENT_ID=

# FMS 文件链接 token 转换。本地测试读取这些变量；不要提交真实值。
# Coze 若没有密钥配置能力，导出后需在 Coze 代码节点里替换 __FMS_*__ 占位值。
FMS_CN_URL=https://cnfmsstream.winit.com.cn
FMS_CN_CLIENT_KEY=
FMS_CN_CLIENT_SECRET=
FMS_CN_USER_KEY=
FMS_CN_USER_SECRET=
FMS_US_URL=https://usfmsstream.winit.com.cn
FMS_US_CLIENT_KEY=
FMS_US_CLIENT_SECRET=
FMS_US_USER_KEY=
FMS_US_USER_SECRET=
FMS_AU_URL=https://aufmsstream.winit.com.cn
FMS_AU_CLIENT_KEY=
FMS_AU_CLIENT_SECRET=
FMS_AU_USER_KEY=
FMS_AU_USER_SECRET=
FMS_EU_URL=https://eufmsstream.winit.com.cn
FMS_EU_CLIENT_KEY=
FMS_EU_CLIENT_SECRET=
FMS_EU_USER_KEY=
FMS_EU_USER_SECRET=

# 飞书专家登记表（与 scripts/sync-expert-register 相同；用于 test:expert:online 解析 coze_workflow_id）
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_BITABLE_APP_TOKEN=
# FEISHU_BITABLE_TABLE_ID=

# 人工客服历史记录表：复用 FEISHU_APP_ID / FEISHU_APP_SECRET 获取 tenant token。
# 注意：不要复用 FEISHU_BITABLE_APP_TOKEN；该变量指向专家登记表。
# FEISHU_HUMAN_SERVICE_WIKI_NODE_TOKEN=
# FEISHU_HUMAN_SERVICE_TABLE_ID=tbl3XLmGtZUm658z
# FEISHU_HUMAN_SERVICE_VIEW_ID=vew1laA6wo

# 当前灰度/生产登记批次，与 experts_recaller release_id 一致（test:expert:online 默认读取）
# EXPERT_REGISTER_RELEASE_ID=
