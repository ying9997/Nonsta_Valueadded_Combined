{
  "nodes": [
    {
      "id": "validate-sku-codes",
      "file": "nodes/validate-sku-codes.ts",
      "inputs": ["skuCodes", "warehouseCode", "importCountryCode", "fetchProfile", "inputContext"],
      "outputs": [
        "normalizedSkuCodes",
        "warehouseCode",
        "importCountryCode",
        "fetchProfile",
        "skipApi",
        "validationError",
        "inputContext"
      ],
      "cozeIo": {
        "outputs": {
          "normalizedSkuCodes": { "type": "array", "items": { "type": "string" } },
          "warehouseCode": { "type": "string" },
          "importCountryCode": { "type": "string" },
          "fetchProfile": { "type": "string" },
          "skipApi": { "type": "boolean" },
          "validationError": { "type": "string" },
          "inputContext": { "type": "object", "additionalProperties": true }
        }
      }
    },
    {
      "id": "resolve-fetch-plan",
      "file": "nodes/resolve-fetch-plan.ts",
      "inputs": ["skipApi", "normalizedSkuCodes", "importCountryCode", "fetchProfile"],
      "outputs": [
        "actions",
        "actionPlans",
        "winitPluginBatchActionsCount",
        "actionName",
