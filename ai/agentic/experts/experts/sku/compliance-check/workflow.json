{
  "nodes": [
    {
      "id": "validate-intent",
      "file": "nodes/validate-intent.ts",
      "inputs": [
        "topic",
        "intentType",
        "skuCode",
        "importCountryCode",
        "productLink",
        "categoryHint",
        "query",
        "customerIntent",
        "inputContext"
      ],
      "outputs": [
        "validationOk",
        "intentType",
        "normalizedTopic",
        "skuCode",
        "importCountryCode",
        "productLink",
        "categoryHint",
        "customerIntent",
        "needInfoHint",
        "profileSnapshot",
        "inputContext"
      ],
      "cozeIo": {
        "outputs": {
          "validationOk": { "type": "boolean" },
          "intentType": { "type": "string" },
          "normalizedTopic": { "type": "string" },
          "skuCode": { "type": "string" },
          "importCountryCode": { "type": "string" },
          "productLink": { "type": "string" },
          "categoryHint": { "type": "string" },
          "customerIntent": { "type": "string" },
          "needInfoHint": { "type": "string" },
          "profileSnapshot": { "type": "object", "additionalProperties": true },
          "inputContext": { "type": "object", "additionalProperties": true }
        }
      }
    },
    {
      "id": "resolve-compliance-fetch",
      "file": "nodes/resolve-compliance-fetch.ts",
      "inputs": ["intentType", "skuCode", "importCountryCode", "profileSnapshot"],
      "outputs": [
        "shouldFetch",
        "fetchProfile",
        "skipApi",
        "skuCode",
        "importCountryCode",
        "intentType",
        "reuseProfileSnapshot"
      ],
      "cozeIo": {
        "outputs": {
          "shouldFetch": { "type": "boolean" },
          "fetchProfile": { "type": "string" },
          "skipApi": { "type": "boolean" },
          "skuCode": { "type": "string" },
          "importCountryCode": { "type": "string" },
          "intentType": { "type": "string" },
          "reuseProfileSnapshot": { "type": "boolean" }
        }
      }
    },
    {
      "id": "build-compliance-page-list",
      "file": "nodes/build-compliance-page-list.ts",
      "inputs": ["shouldFetch", "skipApi", "skuCode", "importCountryCode", "fetchProfile"],
      "outputs": [
        "actions",
        "actionPlans",
        "winitPluginBatchActionsCount",
        "actionName",
        "fetchProfile",
        "skipApi"
      ],
      "cozeIo": {
        "outputs": {
          "actions": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          },
          "actionPlans": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          },
          "winitPluginBatchActionsCount": { "type": "integer" },
          "actionName": { "type": "string" },
          "fetchProfile": { "type": "string" },
          "skipApi": { "type": "boolean" }
        }
      }
    },
    {
      "id": "fetch-compliance-snapshot",
      "file": "nodes/fetch-compliance-snapshot.ts",
      "inputs": [
        "skuCode",
        "importCountryCode",
        "skipApi",
        "reuseProfileSnapshot",
        "profileSnapshot",
        "winitPluginOutputList"
      ],
      "outputs": ["complianceSnapshot", "complianceSnapshotText", "skipFetch"],
      "cozeIo": {
        "outputs": {
          "complianceSnapshot": { "type": "object", "additionalProperties": true },
          "complianceSnapshotText": { "type": "string" },
          "skipFetch": { "type": "boolean" }
        }
      }
    },
    {
      "id": "load-compliance-kb",
      "file": "nodes/load-compliance-kb.ts",
      "inputs": [
        "validationOk",
        "intentType",
        "normalizedTopic",
        "needInfoHint",
        "kbCarriabilityDeep",
        "kbRestricted",
        "kbCertificates",
        "kbWeee",
        "kbEcommerce",
        "kbBrand",
        "kbUnbanDeep",
        "kbDeclaration"
      ],
      "outputs": ["kbContent", "kbScope", "intentType", "normalizedTopic"],
      "cozeIo": {
        "outputs": {
          "kbContent": { "type": "string" },
          "kbScope": { "type": "string" },
          "intentType": { "type": "string" },
          "normalizedTopic": { "type": "string" }
        }
      }
    },
    {
      "id": "llm-analyze",
      "type": "llm",
      "inputs": [
        "query",
        "customerIntent",
        "intentType",
        "normalizedTopic",
        "skuCode",
        "importCountryCode",
        "productLink",
        "categoryHint",
        "needInfoHint",
        "profileSnapshot",
        "complianceSnapshotText",
        "kbContent",
        "inputContext"
      ],
      "outputs": ["analysisResult"]
    },
    {
      "id": "format-output",
      "file": "nodes/format-output.ts",
      "inputs": [
        "analysisResult",
        "intentType",
        "needInfoHint",
        "complianceSnapshotText",
        "inputContext"
      ],
      "outputs": ["structured", "analysis", "outputContext", "enrichedContext"],
      "cozeIo": {
        "outputs": {
          "structured": { "type": "object", "additionalProperties": true },
          "analysis": { "type": "string" },
          "outputContext": { "type": "object", "additionalProperties": true },
          "enrichedContext": { "type": "object", "additionalProperties": true }
        }
      }
    }
  ]
}
