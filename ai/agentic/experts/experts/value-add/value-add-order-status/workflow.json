    {
      "id": "build-sub-goods-request",
      "file": "nodes/build-sub-goods-request.ts",
      "inputs": ["orderStatusInput", "statusFacts"],
      "outputs": ["subGoodsRequestData", "subGoodsActionPlan", "orderStatusInput", "statusFacts"],
      "cozeIo": {
        "outputs": {
          "subGoodsRequestData": { "type": "string" },
          "subGoodsActionPlan": { "type": "object", "additionalProperties": true },
          "orderStatusInput": { "type": "object", "additionalProperties": true },
          "statusFacts": { "type": "object", "additionalProperties": true }
        }
      }
    },
    {
      "id": "fetch-sub-goods",
      "file": "nodes/fetch-sub-goods.ts",
      "inputs": ["subGoodsActionPlan", "subGoodsApiResult"],
      "outputs": ["goodsFacts"],
      "cozeIo": {
        "inputs": { "subGoodsApiResult": { "type": "string" } },
        "outputs": { "goodsFacts": { "type": "object", "additionalProperties": true } }
      }
    },
    {
      "id": "merge-enhancement-data",
      "file": "nodes/merge-enhancement-data.ts",
      "inputs": ["orderStatusInput", "statusFacts", "paymentFacts", "prepaymentFacts", "goodsFacts"],
      "outputs": ["statusFacts", "orderStatusInput"],
      "cozeIo": {
        "outputs": {
          "statusFacts": { "type": "object", "additionalProperties": true },
          "orderStatusInput": { "type": "object", "additionalProperties": true }
        }
      }
    },
    {
      "id": "llm-analyze",
      "type": "llm",
      "promptFile": "prompts/main.md",
      "inputs": ["query", "customerIntent", "orderStatusInput", "statusFacts", "apiBoundaryKb", "inputContext"],
      "outputs": ["analysisResult"]
    },
    {
      "id": "format-output",
      "file": "nodes/format-output.ts",
      "inputs": ["analysisResult", "orderStatusInput", "statusFacts", "inputContext"],
      "outputs": ["structured", "analysis", "outputContext", "enrichedContext"],
      "cozeIo": {
        "inputs": {
          "analysisResult": { "type": "object" },
          "orderStatusInput": { "type": "object" },
          "statusFacts": { "type": "object" },
          "inputContext": { "type": "object" }
        },
        "outputs": {
          "structured": { "type": "object", "additionalProperties": true },
          "analysis": { "type": "string" },
          "outputContext": { "type": "object", "additionalProperties": true },
          "enrichedContext": { "type": "object", "additionalProperties": true }
        }
      }
