          "orderStatusInput": { "type": "object", "additionalProperties": true }
        }
      }
    },
    {
      "id": "build-basic-info-request",
      "file": "nodes/build-basic-info-request.ts",
      "inputs": ["orderStatusInput"],
      "outputs": ["basicInfoRequestData", "basicInfoActionPlan", "orderStatusInput"],
      "cozeIo": {
        "outputs": {
          "basicInfoRequestData": { "type": "string" },
          "basicInfoActionPlan": { "type": "object", "additionalProperties": true },
          "orderStatusInput": { "type": "object", "additionalProperties": true }
        }
      }
    },
    {
      "id": "fetch-basic-info",
      "file": "nodes/fetch-basic-info.ts",
      "inputs": ["orderStatusInput", "basicInfoRequestData", "basicInfoActionPlan", "basicInfoApiResult"],
