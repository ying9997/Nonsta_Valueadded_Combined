      "inputs": [
        "query",
        "customerIntent",
        "inputContext",
        "vasOrderNo",
        "businessNo",
        "includeAtoms",
        "includePayment",
        "includePrepayment",
        "includeGoods",
        "parentGoodsId",
        "maxAtomRows",
        "enrichedContext"
      ],
      "outputs": ["orderStatusInput", "inputContext"],
      "cozeIo": {
        "outputs": {
          "orderStatusInput": { "type": "object", "additionalProperties": true },
          "inputContext": { "type": "object", "additionalProperties": true }
        }
      }
    },
    {
      "id": "load-api-boundary",
      "file": "nodes/load-api-boundary.ts",
