          "paymentActionPlan": { "type": "object", "additionalProperties": true },
          "orderStatusInput": { "type": "object", "additionalProperties": true },
          "statusFacts": { "type": "object", "additionalProperties": true }
        }
      }
    },
    {
      "id": "fetch-payment-list",
      "file": "nodes/fetch-payment-list.ts",
      "inputs": ["paymentActionPlan", "paymentApiResult"],
