      "outputs": [
        "resolvedBasicInfoRequestData",
        "resolvedBasicInfoActionPlan",
        "orderStatusInput",
        "basicInfoFacts",
        "vasListFacts"
      ],
      "cozeIo": {
        "outputs": {
          "resolvedBasicInfoRequestData": { "type": "string" },
          "resolvedBasicInfoActionPlan": { "type": "object", "additionalProperties": true },
          "orderStatusInput": { "type": "object", "additionalProperties": true },
          "basicInfoFacts": { "type": "object", "additionalProperties": true },
          "vasListFacts": { "type": "object", "additionalProperties": true }
        }
      }
    },
    {
      "id": "fetch-resolved-basic-info",
      "file": "nodes/fetch-resolved-basic-info.ts",
      "inputs": ["orderStatusInput", "basicInfoFacts", "vasListFacts", "resolvedBasicInfoApiResult"],
      "outputs": ["resolvedBasicInfoFacts", "orderStatusInput", "basicInfoFacts", "vasListFacts"],
      "cozeIo": {
        "inputs": { "resolvedBasicInfoApiResult": { "type": "string" } },
        "outputs": {
          "resolvedBasicInfoFacts": { "type": "object", "additionalProperties": true },
          "orderStatusInput": { "type": "object", "additionalProperties": true },
          "basicInfoFacts": { "type": "object", "additionalProperties": true },
          "vasListFacts": { "type": "object", "additionalProperties": true }
        }
      }
    },
    {
      "id": "merge-status-data",
      "file": "nodes/merge-status-data.ts",
      "inputs": ["orderStatusInput", "basicInfoFacts", "resolvedBasicInfoFacts", "vasListFacts", "apiBoundaryKb"],
      "outputs": ["statusFacts", "orderStatusInput"],
      "cozeIo": {
        "outputs": {
          "statusFacts": { "type": "object", "additionalProperties": true },
          "orderStatusInput": { "type": "object", "additionalProperties": true }
        }
      }
    },
