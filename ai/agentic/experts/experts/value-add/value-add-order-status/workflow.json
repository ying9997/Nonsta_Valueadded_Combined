          "vasListActionPlan": { "type": "object", "additionalProperties": true },
          "orderStatusInput": { "type": "object", "additionalProperties": true },
          "basicInfoFacts": { "type": "object", "additionalProperties": true }
        }
      }
    },
    {
      "id": "fetch-vas-list",
      "file": "nodes/fetch-vas-list.ts",
      "inputs": ["orderStatusInput", "basicInfoFacts", "vasListActionPlan", "vasListApiResult"],
      "outputs": ["vasListFacts", "orderStatusInput", "basicInfoFacts"],
