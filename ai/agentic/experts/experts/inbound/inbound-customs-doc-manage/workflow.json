          "intent": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "inboundOrderNo": {
            "type": "string"
          },
          "importerCode": {
            "type": "string"
          },
          "customerIntent": {
            "type": "string"
          },
          "inputContext": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
