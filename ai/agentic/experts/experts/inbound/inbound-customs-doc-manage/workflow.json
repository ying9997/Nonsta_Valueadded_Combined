      "cozeIo": {
        "outputs": {
          "tmsRawList": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
        }
      }
    },
    {
      "id": "summarize-tms-transport",
      "file": "nodes/summarize-tms-transport.ts",
      "inputs": ["skipTms", "tmsRawList"],
      "outputs": ["tmsTransportSummary", "tmsTransportRecords"],
      "cozeIo": {
        "outputs": {
          "tmsTransportSummary": { "type": "object", "additionalProperties": true },
          "tmsTransportRecords": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
        }
      }
    },
    {
      "id": "build-vendor-info-request",
      "file": "nodes/build-vendor-info-request.ts",
      "inputs": ["validationOk", "intent", "country"],
      "outputs": ["actions", "umsActionName", "skipUmsApi", "vendorCountryCode", "vendorType"],
      "cozeIo": {
        "outputs": {
          "actions": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          },
          "umsActionName": { "type": "string" },
          "skipUmsApi": { "type": "boolean" },
          "vendorCountryCode": { "type": "string" },
          "vendorType": { "type": "string" }
        }
      }
    },
    {
      "id": "fetch-vendor-info",
      "file": "nodes/fetch-vendor-info.ts",
