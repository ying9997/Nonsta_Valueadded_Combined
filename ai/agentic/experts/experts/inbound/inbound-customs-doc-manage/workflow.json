{
  "nodes": [
    {
      "id": "validate-doc-intent",
      "file": "nodes/validate-doc-intent.ts",
      "inputs": [
        "intent",
        "country",
        "inboundOrderNo",
        "importerCode",
        "transportOrderNo",
        "query",
        "customerIntent",
        "inputContext"
      ],
      "outputs": [
        "validationOk",
        "error",
        "intent",
        "country",
        "inboundOrderNo",
        "transportOrderNo",
        "importerCode",
        "customerIntent",
        "inputContext"
