      "outputs": ["actions", "tmsActionName", "skipTms"],
      "cozeIo": {
        "outputs": {
          "actions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "tmsActionName": { "type": "string" },
          "skipTms": { "type": "boolean" }
        }
      }
    },
    {
      "id": "fetch-tms-transport-order",
      "file": "nodes/fetch-tms-transport-order.ts",
      "inputs": ["skipTms", "actions", "winitTmsPluginOutputList"],
