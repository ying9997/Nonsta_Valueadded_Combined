      "outputs": [
        "kbContent",
        "kbScope",
        "countrySpecificGuide",
        "uploadAction",
        "documentChecklist",
        "operationSteps",
        "umsGapNote",
        "umsDataAvailable",
        "vendorList",
        "matchedVendor",
        "apiAction"
      ],
      "cozeIo": {
        "outputs": {
          "kbContent": {
            "type": "string"
          },
          "kbScope": {
            "type": "string"
          },
          "countrySpecificGuide": {
            "type": "string"
          },
          "uploadAction": {
            "type": "string"
          },
          "umsDataAvailable": {
            "type": "boolean"
          },
          "vendorList": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          },
          "matchedVendor": {
            "type": "object",
            "additionalProperties": true
          },
          "apiAction": {
            "type": "string"
          },
          "documentChecklist": {
            "type": "array",
            "items": { "type": "string" }
          },
          "operationSteps": {
            "type": "array",
            "items": { "type": "string" }
          },
          "umsGapNote": {
            "type": "string"
          },
          "tmsDataAvailable": {
            "type": "boolean"
          },
          "tmsTransportSummary": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    {
      "id": "llm-analyze",
      "type": "llm",
      "inputs": [
        "query",
        "customerIntent",
        "intent",
        "country",
        "inboundOrderNo",
        "importerCode",
        "kbContent",
        "uploadAction",
        "umsDataAvailable",
        "tmsDataAvailable",
        "tmsTransportSummary",
        "inputContext"
      ],
      "outputs": [
        "analysisResult"
      ]
    },
    {
      "id": "format-output",
      "file": "nodes/format-output.ts",
      "inputs": [
        "analysisResult",
        "inputContext",
        "umsDataAvailable",
        "vendorList"
      ],
      "outputs": [
        "structured",
        "analysis",
        "outputContext",
        "enrichedContext"
      ],
      "cozeIo": {
        "inputs": {
          "analysisResult": {
            "type": "object"
          },
          "inputContext": {
            "type": "object"
          }
        },
        "outputs": {
          "structured": {
            "type": "object",
            "additionalProperties": true
          },
          "analysis": {
            "type": "string"
          },
          "outputContext": {
            "type": "object",
            "additionalProperties": true
          },
          "enrichedContext": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
