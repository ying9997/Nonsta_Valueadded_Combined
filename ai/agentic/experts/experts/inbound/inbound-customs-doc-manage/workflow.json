          "matchedVendor": { "type": "object", "additionalProperties": true },
          "vendorFacts": { "type": "object", "additionalProperties": true },
          "gapNote": { "type": "string" },
          "registerGapNote": { "type": "string" }
        }
      }
    },
    {
