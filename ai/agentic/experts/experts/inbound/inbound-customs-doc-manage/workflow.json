      "outputs": ["rawVendorData"],
      "cozeIo": {
        "outputs": {
          "rawVendorData": { "type": "object", "additionalProperties": true }
        }
      }
    },
    {
      "id": "merge-vendor-info",
      "file": "nodes/merge-vendor-info.ts",
      "inputs": ["skipUmsApi", "rawVendorData", "importerCode", "intent", "vendorCountryCode"],
