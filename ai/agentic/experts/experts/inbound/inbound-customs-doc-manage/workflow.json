        "intent",
        "country",
        "inboundOrderNo",
        "importerCode",
        "registerGapNote",
        "vendorFacts",
        "umsDataAvailable",
        "tmsTransportSummary",
        "kbUploadGuide",
        "kbImporterRegister",
        "kbImporterQuery",
        "kbGeneral"
