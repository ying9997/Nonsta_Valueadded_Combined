      "inputs": [
        "query",
        "customerIntent",
        "country",
        "destinationCountry",
        "goodsType",
        "goodsWeight",
        "goodsDimensions",
        "enrichedContext",
        "inputContext"
      ],
      "outputs": [
        "valid",
        "error",
        "countryResolved",
        "countrySource",
        "goodsInfo",
        "kbScope",
        "enrichedContext",
        "inputContext"
      ],
      "cozeIo": {
        "outputs": {
          "valid": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "countryResolved": {
            "type": "string"
          },
          "countrySource": {
            "type": "string"
          },
          "goodsInfo": {
            "type": "object",
            "additionalProperties": true
          },
          "kbScope": {
            "type": "string"
          },
          "enrichedContext": {
            "type": "object",
            "additionalProperties": true
          },
          "inputContext": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    {
      "id": "load-knowledge",
      "file": "nodes/load-knowledge.ts",
      "inputs": [
        "countryResolved",
        "kbScope",
        "kbDeliveryUs",
        "kbDeliveryUk",
        "kbDeliveryDe",
        "kbDeliveryAu",
        "kbDeliveryCa"
      ],
      "outputs": [
        "kbContent",
        "countryResolved"
      ],
      "cozeIo": {
        "outputs": {
          "kbContent": {
            "type": "string"
          },
          "countryResolved": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "llm-analyze",
      "type": "llm",
      "inputs": [
        "query",
        "customerIntent",
        "countryResolved",
        "goodsInfo",
