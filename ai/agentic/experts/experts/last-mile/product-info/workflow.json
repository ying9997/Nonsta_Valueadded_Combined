{
  "nodes": [
    {
      "id": "validate-input",
      "file": "nodes/validate-input.ts",
      "inputs": [
        "query",
        "customerIntent",
        "country",
        "destinationCountry",
        "productLine",
        "enrichedContext",
        "inputContext"
      ],
      "outputs": [
        "valid",
        "error",
        "customerIntent",
        "countryResolved",
        "countrySource",
        "productLine",
        "directMatch",
        "matchedProductNames",
        "kbScope",
        "enrichedContext",
        "inputContext"
      ],
      "cozeIo": {
        "outputs": {
          "valid": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "customerIntent": {
            "type": "string"
          },
          "countryResolved": {
            "type": "string"
          },
          "countrySource": {
            "type": "string"
          },
          "productLine": {
            "type": "string"
          },
          "directMatch": {
            "type": "boolean"
          },
          "matchedProductNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kbScope": {
            "type": "string"
          },
          "enrichedContext": {
            "type": "object",
            "additionalProperties": true
          },
          "inputContext": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    {
      "id": "load-product-knowledge",
      "file": "nodes/load-product-knowledge.ts",
      "inputs": [
        "countryResolved",
        "productLine",
        "kbScope",
        "directMatch",
        "matchedProductNames",
        "kbPscIndex",
        "kbWfIndex",
        "kbPalletIndex",
        "kbPscUs",
        "kbPscUk",
        "kbPscDe",
        "kbPscAu",
        "kbPscCa",
        "kbWfUs",
        "kbWfUk",
        "kbWfDe",
        "kbWfAu",
        "kbPalletUs",
        "kbPalletDe"
      ],
      "outputs": [
        "kbContent",
        "kbScope",
        "countryResolved",
        "productLine"
      ],
      "cozeIo": {
        "outputs": {
          "kbContent": {
            "type": "string"
          },
          "kbScope": {
            "type": "string"
          },
          "countryResolved": {
            "type": "string"
          },
          "productLine": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "llm-analyze",
      "type": "llm",
      "inputs": [
        "query",
        "customerIntent",
        "countryResolved",
        "productLine",
        "matchedProductNames",
        "kbContent",
        "enrichedContext",
        "examplesMd"
      ],
      "outputs": [
        "analysisResult"
      ]
    },
    {
      "id": "format-output",
      "file": "nodes/format-output.ts",
      "inputs": [
        "analysisResult",
        "inputContext"
      ],
      "outputs": [
        "structured",
        "analysis",
        "outputContext",
        "enrichedContext"
      ],
      "cozeIo": {
        "inputs": {
          "analysisResult": {
            "type": "object"
          },
          "inputContext": {
            "type": "object"
          }
        },
        "outputs": {
          "structured": {
            "type": "object",
            "additionalProperties": true
          },
          "analysis": {
            "type": "string"
          },
          "outputContext": {
            "type": "object",
            "additionalProperties": true
          },
          "enrichedContext": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  ]
}
