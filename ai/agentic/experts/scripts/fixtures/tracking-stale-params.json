        "valid": false,
        "branch": "need_human",
        "missingFactsIncludes": ["staleFacts"]
      }
    },
    {
      "id": "with_upstream_context",
      "description": "有上游 enrichedContext 与 previousOutput，可进入正常分析链路",
      "params": {
        "query": "客户反馈轨迹停滞",
        "trackingIds": [
          "1Z999AA10123456784"
        ],
        "customerIntent": "已超过10天未更新，想确认是否能索赔",
        "enrichedContext": {
          "recognizedException": false,
          "ascanDetected": true,
          "noUpdateDays": 11,
          "hasClaimService": true,
          "isDomestic": true,
          "claimWindowStatus": "in_window"
        },
        "inputContext": {
          "chainId": "case-stale-001",
          "sourceExpertId": "delivery-status",
          "previousOutput": {
            "analysis": "最后轨迹更新时间为 4/20，当前已超 10 天。"
          }
        }
      },
      "expect": {
        "valid": true,
        "staleFactsSource": "upstream_noUpdateDays",
        "staleFactsCalcStatus": "ok",
        "staleFactsIsOver10Days": true,
        "branch": "domestic_claim_recommended",
        "suggestedNextExpertsIncludes": ["substitute-claim"],
        "analysisIncludes": ["支持丢失类代客索赔", "查件"]
      }
    },
    {
