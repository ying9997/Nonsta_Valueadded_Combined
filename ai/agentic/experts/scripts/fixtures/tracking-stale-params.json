        "customerIntent": "轨迹异常",
        "enrichedContext": {
          "ascanDetected": true,
          "noUpdateDays": 22,
          "lastTrackingAt": "2026-04-22 11:46:00",
          "hasClaimService": false,
          "isDomestic": false,
          "computedScanFacts": [
            {
              "trackingNo": "FE519438375GB",
              "deliveryFailureLikely": false,
              "ascanEvents": [
                {
                  "description": "Shipment Received in Depot",
                  "location": null,
                  "status": "Ascan",
                  "time": "2026-04-21 04:47:00"
                }
              ],
              "dscanEvents": [
                {
                  "description": "派送完成",
                  "location": null,
                  "status": "Dscan",
                  "time": "2026-04-22 11:46:00"
                }
              ],
              "rdscanEvents": []
            }
          ]
        },
        "inputContext": {
          "chainId": "case-stale-delivered",
          "sourceExpertId": "delivery-status",
          "previousOutput": {
            "analysis": "轨迹显示已派送完成。"
          }
        }
      },
      "expect": {
        "valid": true,
        "staleFactsSource": "upstream_noUpdateDays",
        "staleFactsCalcStatus": "ok",
        "staleFactsIsOver10Days": false,
        "staleFactsIsDelivered": true,
        "branch": "terminal_delivered_not_stale",
        "analysisExcludes": ["无索赔服务"]
      }
    },
