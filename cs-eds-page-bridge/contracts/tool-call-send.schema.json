{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cobra tool_call_send arguments for EDS page tools",
  "description": "function_name + arguments 交给 cobra_agent_http.tool_call_send。arguments 在插件里是 string，此处描述 parse 之后的对象。",
  "oneOf": [
    {
      "title": "pageRead",
      "type": "object",
      "required": ["function_name", "arguments"],
      "properties": {
        "function_name": { "const": "pageRead" },
        "arguments": {
          "type": "object",
          "properties": {
            "reason": { "type": "string" }
          }
        }
      }
    },
    {
      "title": "renderA2UI",
      "type": "object",
      "required": ["function_name", "arguments"],
      "properties": {
        "function_name": { "const": "renderA2UI" },
        "arguments": {
          "type": "object",
          "required": ["commands"],
          "properties": {
            "commands": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "./a2ui-command.schema.json" }
            }
          }
        }
      }
    }
  ]
}
