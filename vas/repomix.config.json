{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "showLineNumbers": true,
    "topFilesLength": 10,
    "removeComments": false
  },
  "include": [
    "README.md",
    "HANDOFF.md",
    "design/**",
    "contracts/**",
    "engine/**",
    "routing/**",
    "eval/**/*.md",
    "eval/**/*.json",
    "prototypes/**/*.md",
    "sibling/**/*.md",
    "references/**/*.md",
    "references/**/*.json",
    "context/**"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "iterations/**",
      "**/*.html",
      "references/pages/**",
      "eval/**/*.jsonl",
      "eval/**/*.py",
      "repomix-output.*",
      ".git/**"
    ]
  }
}
