
/**
 * 循环遍历数组或对象
 * @param  {[Array,Object]} collection 数组或js对象
 * @param  {[function]}     iterator   有两个参数：
 *    1、如果collection是数组，第一个参数是数组索引，第二个参数是索引位置的值
 *    2、如果collection是对象，第一个参数是属性，第二个参数是属性对应的值
 */
function each(collection, iterator) {
	if(Object.prototype.toString.call(collection) === "[object Array]") {
		for(var i = 0, len = collection.length; i < len; i ++) {
			iterator(i, collection[i]);
		}
	} else {
		for(var p in collection) {
			iterator(p, collection[p]);
		}
	}

}

