/**
 * 显示 form表单元素所在的块
 * .ignore 设置该样式，表单不检测此项
 * @param  {jQuery} element form表单元素对象
 * @return {jQuery}         返回执行后的表单元素对象
 */
function show(element) {
	element.removeClass('ignore').parents(".form-group").show();
	return element;
}

/**
 * 隐藏 form表单元素所在的块
 * .ignore 设置该样式，表单不检测此项
 * @param  {jQuery} element form表单元素对象
 * @return {jQuery}         返回执行后的表单元素对象
 */
function hide(element) {
	element.addClass('ignore').parents(".form-group").hide();
	return element;
}

/**
 * 给指定form表单元素添加.ignore 设置该样式，表单不检测此项
 * @param {jQuery} element_form表单元素
 * @return {jQuery} 返回执行后的表单元素
 */
function addIgnoreValidate(element){
	element.addClass('ignore').parent().prevAll('.control-label:first-child').children('em').hide();
	return element;
}

/**
 * 给指定form表单元素删除.ignore
 * @param {jQuery} element_form表单元素
 * @return {jQuery} 返回执行后的表单元素
 */
function cancelIgnoreValidate(element){
	element.removeClass('ignore').parent().prevAll('.control-label:first-child').children('em').show();
	return element;
}

/**
 * 选择checkbox
 * @_list   {[Array]} checkbox集合
 * @_param  {[String]} all:全选，not:不选，invert:反选
 */
var selctCheckbox = function(_list, _param) {
	if(_param == "all") {
		_list.each(function(){
			this.checked = true;
		});
	} else if(_param == "invert") {
		_list.each(function(){
			this.checked = !this.checked;
		});
	} else if(_param == "not"){
		_list.each(function(){
			this.checked = false;
		});
	}
	return _list;
}

