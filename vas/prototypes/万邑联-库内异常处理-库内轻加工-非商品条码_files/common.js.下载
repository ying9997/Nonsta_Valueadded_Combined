function countDown(datetimeOffset, format, callback) {
	var timer = 0;
	var time = Math.ceil(datetimeOffset / 1000);

	var cd = function () {
		time -= 1;

		var d = Math.floor(time / (3600 * 24));

		var t = time % (3600 * 24);

		var hour = Math.floor(t / 3600);
		hour = (hour < 10 ? '0' + hour : hour);

		t = t % 3600;

		var minuter = Math.floor(t / 60);
		minuter = (minuter < 10 ? '0' + minuter : minuter);

		t = t % 60;

		var second = t;

		second = (second < 10 ? '0' + second : second);

		var str = format.replace('d', d)
						.replace('hh', hour)
						.replace('mm', minuter)
						.replace('ss', second);

		if (time <= 0) {
			clearInterval(timer);
			callback && callback('');
		} else {
			callback && callback(str);
		}
	}

	timer = setInterval(function () {
		cd();
	}, 1000);
	cd();
}

