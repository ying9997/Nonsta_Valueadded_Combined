 * 列表数据过长解决方案
 * @param  {string}           data       [数据]
 * @param  {string}           maxWidth   [最大宽度 eg:150px]
 * @param  {string}           otherStyle [其他css样式 eg:color:red;]
 */
function resolveListOverflow (data, maxWidth, otherStyle){
    data = data && data.replace(/&/g, '&amp;')
                   .replace(/</g, '&lt;')
                   .replace(/>/g, '&gt;')
                   .replace(/"/g, '&quot;')
                   .replace(/'/g, '&apos;')
    return data ? '<div style="text-overflow:ellipsis;overflow:hidden;white-space:nowrap;max-width:' + (maxWidth || '150px') + ';' + (otherStyle || '') + '"data-toggle="tooltip" title="'+data+'">' + data + '</div>' : '';
}

/**
 * 对传进来的字符串里的 &、"、'、<、>做转意，防止在拼接字符串的时候出现xss漏洞和字符串断开的问题
 * @param {string} str 要转意的字符串
 * @return {string} 转意后的字符串
 */
function escapeHtml(str) {
	if (typeof str === 'string') {
		return str.replace(/&/g, '&amp;')
			.replace(/"/g, '&quot;')
			.replace(/'/g, '&#39;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;');
	}
	return str;
}
/**
 * 设置本地存储值
 * @param key
 * @param val
 */
function setLocalStorageValue(key,val){
	if(window.Storage && window.localStorage && window.localStorage instanceof Storage){//浏览器支持本地存储
		localStorage.setItem(key,val); 
	}else{
		$.cookie(key, val, { expires: 30 });
	}
}
/**
 * 获取本地存储值
 * @param key
 * @returns
 */
function getLocalStorageValue(key){
	if(window.Storage && window.localStorage && window.localStorage instanceof Storage){//浏览器支持本地存储
		return localStorage.getItem(key);
	}else{
		return $.cookie(key);
	}
}
/**
 * 清除本地存储值
 * @param key
 */
function clearLocalStorageValue(key){
	if(window.Storage && window.localStorage && window.localStorage instanceof Storage){//浏览器支持本地存储
		localStorage.removeItem(key);
	}else{
		$.cookie(key, null);
	}
}

var userSessionStorage = {
    setItem: function(key, value) {
        window.sessionStorage.setItem(window.userId+'_'+ key,value);
    },
    getItem: function(key) {
        return window.sessionStorage.getItem(window.userId+'_'+key);
    },
    removeItem: function(key) {
        window.sessionStorage.removeItem(window.userId+'_'+key);
    }
};
