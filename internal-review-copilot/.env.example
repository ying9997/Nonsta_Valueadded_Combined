# LiteLLM
LITELLM_BASE_URL=https://your-litellm-endpoint/v1
LITELLM_API_KEY=your-key-here
LITELLM_MODEL=claude-sonnet-4-5
LITELLM_TIMEOUT_MS=45000

# Feishu Bot（增值咨询应用；secret 勿提交，只放本机 .env）
# slug: internal-review-copilot；上 40 前须过本机 E2E 门禁（见 00_INDEX/AI_IDE_WORKSPACE_RULES.md §9）
FEISHU_APP_ID=cli_aa2a76198a7adcb3
FEISHU_APP_SECRET=your-secret-here
FEISHU_TEST_CHAT_ID=oc_80b07f38ed6833df3787a97a496f1097
FEISHU_TEST_USER_ID=ou_xxxxx
FEISHU_TEST_USER_NAME=your-name

# OAuth login (feishu-login.ts). Do not put user_access_token here.
FEISHU_REDIRECT_URI=http://localhost:9988/callback
FEISHU_OAUTH_PORT=9988

# OMS 草稿写入。OMS_WRITE_ENABLED=1 且 allowlist 含单号或 * 才真写。
# Cookie 对齐 auto_login.py 产出（不是 .cookies.json）
TOM_COOKIE_PATH=AI_EXPERT/TOM/共享认证/playwright_cookies.json
OMS_WRITE_ENABLED=0
OMS_WRITE_ALLOWLIST=*

# 最小 RAG（BM25 few-shot）。默认关；1=开
RAG_ENABLED=0
