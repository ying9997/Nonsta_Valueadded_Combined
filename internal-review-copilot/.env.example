# LiteLLM
LITELLM_BASE_URL=https://your-litellm-endpoint/v1
LITELLM_API_KEY=your-key-here
LITELLM_MODEL=claude-sonnet-4-5
# 主模型权限/5xx/超时/限流时可换（逗号分隔；勿与主模型重复）
LITELLM_MODEL_FALLBACKS=claude-sonnet-4-6,claude-haiku-4-5
LITELLM_TIMEOUT_MS=45000

# Feishu Bot（增值咨询应用；secret 勿提交）
# 本机开发：可放本目录 .env（勿提交）
# 40 常驻（方案 A）：只放 ~/.secrets/vas-internal-review.env（0600）
#   slug: vas-internal-review
#   运行目录: /workspace/projects/value-service/vas-internal-review
#   上 40 前须过本机 E2E 门禁（见 00_INDEX/AI_IDE_WORKSPACE_RULES.md §9）
#   落位说明: _workflow/20260923_vas_internal_review_40_layout/README.md
FEISHU_APP_ID=cli_aa2a76198a7adcb3
FEISHU_APP_SECRET=your-secret-here
FEISHU_TEST_CHAT_ID=oc_80b07f38ed6833df3787a97a496f1097
FEISHU_TEST_USER_ID=ou_xxxxx
FEISHU_TEST_USER_NAME=your-name
# Bot 自己的 open_id，话题里 @bot 找场景会用到。控制台需开启 im.message.receive_v1
FEISHU_BOT_OPEN_ID=ou_xxxxx
# 单聊/群@「禁止使用」必须为 1，否则 listen 只收卡片按钮
# LISTEN_IM=1

# OAuth login (feishu-login.ts). Do not put user_access_token here.
FEISHU_REDIRECT_URI=http://localhost:9988/callback
FEISHU_OAUTH_PORT=9988

# OMS 草稿写入。OMS_WRITE_ENABLED=1 且 allowlist 含单号或 * 才真写。
# Cookie 对齐 auto_login.py 产出（不是 .cookies.json）
TOM_COOKIE_PATH=AI_EXPERT/TOM/共享认证/playwright_cookies.json
OMS_WRITE_ENABLED=0
OMS_WRITE_ALLOWLIST=*

# 最小 RAG（BM25 few-shot）。默认关；1=开
RAG_ENABLED=0

# 跨 WI SKU 校验（H11）。查 DWS 入库商品；token 也可放 ~/.secrets/winit-data-mcp.env
# WINIT_DATA_MCP_URL=http://172.16.3.40/winit-data-mcp/mcp
# WINIT_DATA_MCP_TOKEN=
# SKU_CHECK_TIMEOUT_MS=25000

# 部署防线（详见 docs/canary-deploy-guide.md）。默认关金丝雀。
# 满额后点飞书按钮「没问题，切到正式群」即可，不必把 CANARY_MODE 改回 0。
CANARY_MODE=0
CANARY_CHAT_ID=
CANARY_LIMIT=5
BREAKER_WINDOW=5
BREAKER_RED_THRESHOLD=2
BREAKER_TRANSFER_THRESHOLD=3
BREAKER_ALERT_USER_ID=
MAX_PER_HOUR=10
MAX_PER_POLL=2
