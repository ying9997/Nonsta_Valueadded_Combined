[Unit]
Description=VAS Internal Review · poll-and-assess (vas-internal-review)
Documentation=file:///workspace/projects/value-service/vas-internal-review/README.md
After=default.target

[Service]
Type=simple
WorkingDirectory=/workspace/projects/value-service/vas-internal-review
EnvironmentFile=-/home/winit/.secrets/vas-internal-review.env
Environment=IRC_ENV_FILE=/home/winit/.secrets/vas-internal-review.env
ExecStart=/workspace/projects/value-service/vas-internal-review/run-poll.sh
Restart=always
RestartSec=5
StandardOutput=append:/workspace/projects/value-service/vas-internal-review/logs/poll.log
StandardError=append:/workspace/projects/value-service/vas-internal-review/logs/poll.log

[Install]
WantedBy=default.target
